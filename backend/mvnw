#!/usr/bin/env sh
# Minimal self-contained Maven wrapper (POSIX). Uses installed mvn or downloads it.
set -e

MAVEN_VERSION=3.9.9
MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"
DIST_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ ! -x "$DIST_DIR/apache-maven-$MAVEN_VERSION/bin/mvn" ]; then
  echo "[mvnw] mvn not found - downloading Apache Maven $MAVEN_VERSION..." >&2
  mkdir -p "$DIST_DIR"
  curl -fsSL "$MAVEN_URL" -o "$DIST_DIR/maven.tar.gz"
  tar -xzf "$DIST_DIR/maven.tar.gz" -C "$DIST_DIR"
fi

exec "$DIST_DIR/apache-maven-$MAVEN_VERSION/bin/mvn" "$@"