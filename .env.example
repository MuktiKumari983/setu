# ============================================================
#  SIH26043 - Societal Innovation Collaboration Platform
#  Copy this file to .env and fill in your local values.
#  NEVER commit your real .env.
# ============================================================

# ---- Database (used by docker-compose MySQL) ----
MYSQL_DATABASE=sih_platform
MYSQL_USER=sih
MYSQL_PASSWORD=sih_password
MYSQL_ROOT_PASSWORD=root_password

# ---- Backend ----
DB_URL=jdbc:mysql://mysql:3306/sih_platform?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=sih
DB_PASSWORD=sih_password

# JWT secret: any long random string (min 32 chars). Change in production.
JWT_SECRET=dev-secret-change-me-please-32-characters-minimum
JWT_ALLOW_DEV_SECRET=true
JWT_EXPIRATION_MS=86400000
APP_SEED_ENABLED=true

# ---- AI service ----
AI_SERVICE_URL=http://ai-service:8000
# Set to false to use the built-in lightweight Java fallback engine
AI_ENABLED=true

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173